<?xml version="1.0" encoding="UTF-8"?>
<!-- PowerPoint のスライドに置くコンテンツ アドイン。GitHub Pages に置いた docs/ を表示する -->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:type="ContentApp">
  <Id>d7a29fd6-c7ec-4e91-aa67-e9044110eb30</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>HTML Frame</ProviderName>
  <DefaultLocale>ja-JP</DefaultLocale>
  <DisplayName DefaultValue="HTML Frame" />
  <Description DefaultValue="スライド上で HTML や Web ページを表示し、スライドショー中も操作できます。" />
  <IconUrl DefaultValue="https://takadasohta.github.io/pptx-html-frame/assets/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://takadasohta.github.io/pptx-html-frame/assets/icon-64.png" />
  <SupportUrl DefaultValue="https://github.com/TakadaSohta/pptx-html-frame" />
  <AppDomains>
    <AppDomain>https://takadasohta.github.io</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Presentation" />
  </Hosts>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://takadasohta.github.io/pptx-html-frame/index.html" />
    <RequestedWidth>640</RequestedWidth>
    <RequestedHeight>360</RequestedHeight>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <AllowSnapshot>true</AllowSnapshot>
</OfficeApp>
